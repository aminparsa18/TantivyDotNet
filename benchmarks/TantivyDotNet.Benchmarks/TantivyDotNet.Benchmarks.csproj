<Project Sdk="Microsoft.NET.Sdk">

  <!-- TantivyDotNet vs Lucene.NET 4.8 on the same Wikipedia corpus. See README.md for how to run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Lucene.NET 4.8 is still a beta; NU5104 only warns about depending on a prerelease. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00018" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00018" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TantivyDotNet/TantivyDotNet.csproj" />
  </ItemGroup>

</Project>
