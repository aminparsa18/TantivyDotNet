<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the compatibility fixture of a released version: the CompatCorpus index, written by the
    TantivyDotNet package of that version from nuget.org, zipped into the test project. Run it after
    each release (see CONTRIBUTING.md, "Releasing"), with a version that's on nuget.org:

      dotnet run -\-project tests/TantivyDotNet.CompatFixture -p:TantivyCompatVersion=0.4.0-preview.1

    Not part of TantivyDotNet.slnx: it never builds against the project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="RequireCompatVersion" BeforeTargets="Restore;CollectPackageReferences">
    <Error Condition="'$(TantivyCompatVersion)' == ''"
           Text="Pass the released version to write a fixture for: -p:TantivyCompatVersion=X.Y.Z" />
  </Target>

  <ItemGroup>
    <PackageReference Include="TantivyDotNet" Version="[$(TantivyCompatVersion)]" Condition="'$(TantivyCompatVersion)' != ''" />
    <Compile Include="../TantivyDotNet.Tests/Compat/CompatCorpus.cs" Link="CompatCorpus.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TantivyCompatVersion</_Parameter1>
      <_Parameter2>$(TantivyCompatVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
