<Project Sdk="Microsoft.NET.Sdk">

  <!-- A child process for the crash tests in TantivyDotNet.Tests (LifecycleCrashTests), which start it
       and kill it in the middle of indexing. Referenced by the test project so its output lands next
       to the tests. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TantivyPackageVersion)' == ''">
    <ProjectReference Include="../../src/TantivyDotNet/TantivyDotNet.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TantivyPackageVersion)' != ''">
    <PackageReference Include="TantivyDotNet" Version="[$(TantivyPackageVersion)]" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TantivyPackageVersion)' != ''">
    <RestoreAdditionalProjectSources>$(TantivyPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
