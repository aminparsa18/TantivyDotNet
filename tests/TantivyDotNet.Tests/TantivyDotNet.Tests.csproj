<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The child process of the crash tests; referenced so its build output (dll, runtimeconfig, deps) is copied next to the tests. -->
  <ItemGroup>
    <ProjectReference Include="../TantivyDotNet.CrashHelper/TantivyDotNet.CrashHelper.csproj" />
  </ItemGroup>

  <!-- Normally tests run against the project. With TantivyPackageVersion set (CI), they run against the
       packed TantivyDotNet package instead, restored from TantivyPackageSource. That checks the package
       layout and the native library CI built for this runner's RID. -->
  <ItemGroup Condition="'$(TantivyPackageVersion)' == ''">
    <ProjectReference Include="../../src/TantivyDotNet/TantivyDotNet.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TantivyPackageVersion)' != ''">
    <PackageReference Include="TantivyDotNet" Version="[$(TantivyPackageVersion)]" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TantivyPackageVersion)' != ''">
    <RestoreAdditionalProjectSources>$(TantivyPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
