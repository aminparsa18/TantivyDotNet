<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for the test run: only the TantivyDotNet library itself is measured. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]TantivyDotNet\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Generated P/Invoke declarations. -->
        <Source>.*NativeMethods\.g\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
